{
  "name": "@tsnomad/event",
  "version": "0.1.0",
  "description": "Event strategy with listeners and parallel broadcast, the TypeScript counterpart to PHPNomad's event package",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/tsnomad/event.git" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./event-strategy": { "types": "./dist/EventStrategy.d.ts", "default": "./dist/EventStrategy.js" },
    "./types": { "types": "./dist/types.d.ts", "default": "./dist/types.js" }
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
